# ─────────────────────────────────────────────────────────────
# IdeaForge — IBM Watsonx.ai Configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# IBM Cloud API Key (IAM)
IBM_API_KEY=

# IBM Watsonx.ai Project ID
WATSONX_PROJECT_ID=

# Watsonx.ai service URL (region-specific)
# Dallas:  https://us-south.ml.cloud.ibm.com
# Sydney:  https://au-syd.ml.cloud.ibm.com
# London:  https://eu-gb.ml.cloud.ibm.com
# Frankfurt: https://eu-de.ml.cloud.ibm.com
WATSONX_URL=

# Watsonx.ai model ID — MUST support text/generation (Granite models do; Llama models do NOT)
# Recommended options:
#   ibm/granite-3-8b-instruct       (default, fast, best for structured JSON)
#   ibm/granite-13b-instruct-v2     (larger, more detailed output)
#   ibm/granite-3-2b-instruct       (lightest, lowest cost)
WATSONX_MODEL_ID=

# Flask secret key (any random string)
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# Set to "production" for deployment
FLASK_ENV=development
